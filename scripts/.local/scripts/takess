#!/bin/sh
# depends on maim/slop (X11) and grim/slurp/mmsg/jq (Wayland - MangoWC)

icon=${XDG_PICTURES_DIR:-~/pix}/assets/icons/camera-solid.svg
dir=${XDG_PICTURES_DIR:-~/pix}/scrots
mkdir -p "$dir"
name=$(date +%Y-%m-%d_%H-%M-%S).png

if [ -n "$WAYLAND_DISPLAY" ]; then
    windows=$(mmsg get all-clients | jq -r '.clients[] | select(.is_visible) | "\(.x),\(.y) \(.width)x\(.height)"' 2>/dev/null)
    
    # Added -o flag to include whole monitors as selectable regions. 
    # Right-click natively cancels slurp.
    if [ -n "$windows" ]; then
        geom=$(echo "$windows" | slurp -o 2>/dev/null)
    else
        geom=$(slurp -o 2>/dev/null)
    fi
    
    [ -n "$geom" ] && grim -g "$geom" "$dir/$name"
else
    # Fallback for X11
    maim -k -s "$dir/$name"
fi

[ -f "$dir/$name" ] && notify-send -r 13 -i "$dir/$name" "Screenshot" "Saved in\n$dir" || notify-send -r 13 -i "$icon" -a volume "Screenshot" "Exiting without taking one"
exit
