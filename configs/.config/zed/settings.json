// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "disable_ai": true,
  "format_on_save": "off",
  //"use_smartcase_search": true,
  "search": {
    "case_sensitive": true,
  },
  "feature_flags": {
    "notebooks": "on",
    "tabular-data-preview": "on",
  },
  "cli_default_open_behavior": "new_window",
  "title_bar": {
    "show_sign_in": false,
  },
  "agent": {
    "flexible": true,
    "button": false,
    "favorite_models": [],
    "model_parameters": [],
  },
  "project_panel": {
    "default_width": 240.0,
    "dock": "left",
  },
  "terminal": {
    "font_weight": 500.0,
    "font_family": "Fragment Mono",
    "font_size": 14.0,
    "blinking": "off",
  },
  "cursor_shape": "bar",
  "cursor_blink": false,
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "vim_mode": true,
  "ui_font_size": 15,
  "buffer_font_size": 15,
  "theme": {
    "mode": "light",
    "light": "Gruvbox Light Hard",
    "dark": "Gruvbox Dark Hard"
  },
}
