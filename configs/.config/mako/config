max-history=10
sort=-time
on-button-left=invoke-default-action
on-button-middle=none
on-button-right=dismiss
on-touch=dismiss
on-notify=none

font=sans-serif 10
background-color=#202020
text-color=#bdae93
width=320
height=200
# top,right,bottom,left
padding=20,20,20,20
border-size=1
outer-margin=0,0,200,0
border-color=#282828
border-radius=4
icons=1
max-icon-size=32
icon-location=left
format=<span font="monospace 10" weight="200" line-height="1.5"><b>%s</b></span>\n<span font="monospace 10" color="#a89984" line_height="1.2">%b</span>
default-timeout=5000
anchor=top-center
layer=top

[app-name="scripts"]
default-timeout=2000

[app-name="osd"]
font=monospace 16
background-color=#212121ee
text-color=#ebdbb2
padding=25,0,0,0
width=140
height=180
progress-color=#7DAEA3cc
border-size=1
border-color=#292929
border-radius=4
icons=1
max-icon-size=36
icon-path=""
icon-location=top
icon-border-radius=0
format=%b
text-alignment=center
default-timeout=1000
ignore-timeout=0
anchor=bottom-center
layer=overlay
