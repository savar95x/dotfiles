{
    "layer": "bottom",
    "position": "top",
    "height": 50,
    "spacing": 2,
    "margin-bottom": 0,
    
    "modules-left": [
        "mango/workspaces",
        //"mango/layout",
        "custom/mango-layout",
        "mango/window"
    ],
    "modules-center": [],
    "modules-right": [
        "mpd",
        "bluetooth",
        "image#battery",
        "battery",
        "network",
        "custom/controlpanel",
        "clock"
    ],

    // Workspaces - Fixed to hide empty tags
    "mango/workspaces": {
        "format": "{name}",
        "disable-scroll": true,
        "all-outputs": false,
        "hide-empty": true,
        "on-click": "activate"
    },

    "mango/layout": {
        "format": "{symbol}",
        "format-T": "::",
        "format-S": "-S-",
        "format-M": "[M]"
    },

    "custom/mango-layout": {
        "exec": "~/.config/waybar/scripts/mango-layout.sh",
        "return-type": "json",
        "format": "<span font='Inter 15px'>{}</span>",
        "on-click": "mmsg dispatch switch_layout"
    },

    // Active Window
    "mango/window": {
        "format": "{title}",
        "max-length": 50
    },

    // MPD (Music)
    "mpd": {
        "format": "{stateIcon}   <span color='#928374'>{artist} - {title}</span>",
        "format-disconnected": "",
        "format-stopped": "",
        "state-icons": {
            "playing": "<span font='material symbols rounded 15px' rise='-2000'>music_note</span>",
            "paused": "<span font='material symbols rounded 15px' rise='-2000'>pause</span>"
        },
        "max-length": 40,
        "tooltip-format": "MPD (connected)",
        "on-click": "mpc toggle"
    },

    // Bluetooth
    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-connected": "<span font='16px'></span>",
        "format-connected-battery": "<span font='material symbols rounded 16px' rise='-2000'>bluetooth</span>   <span font='14px' color='#928374'>{device_battery_percentage}%</span>",
        "tooltip-format-connected": "{device_alias}"
    },

    "image#battery": {
        "exec": "~/.config/waybar/scripts/dynamic_battery_icon.sh",
        "size": 22,
        "interval": 10,
        "on-click": "~/.local/scripts/sb_battery notify"
    },

    // Battery
    "battery": {
        "states": {
            "full": 85,
            "critical": 14
        },
        "format": "<span font='14px' color='#928374'>{capacity}%</span>",
        "format-charging": "<span font='14px' color='#928374'>{capacity}%</span>",
        "format-plugged": "   <span color='#928374'>{capacity}%</span>",
        "format-icons": ["", "", "", "", ""],
        "on-click": "~/.local/scripts/sb_battery notify"
    },

    // Wi-Fi
    "network": {
        "interface": "wlan0",
        "interval": 60,
        "format-wifi": "<span font='16px'>{icon}</span>",
        "format-disconnected": "",
        "format-icons": ["", "", ""],
        "tooltip-format": "{essid} ({signalStrength}%)",
        "on-click": "notify-send -i ~/pix/assets/icons/wifi-solid.svg -a scripts --replace-id=12 'Network' \"$(iwctl station wlan0 show | awk -F 'Connected network' '/Connected network/ {print $2}' | xargs)\""
    },

    // Control Panel
    "custom/controlpanel": {
        "format": "<span font='17px'></span>",
        "on-click": "~/.config/eww/scripts/control_center",
        "tooltip": false
    },

    // Date & Time Combined
    "clock": {
        "interval": 60,
        "format": "<span color='#928374'>{0:%a %d %b}</span>   <span weight='400'>{0:%I:%M}</span>  <span font='12px'>{0:%p }</span>",
        "on-click": "~/.local/scripts/datenotif"
    }
}
