{
    "layer": "bottom",
    "position": "top",
    "height": 50,
    "spacing": 10,
    "margin-bottom": 0,
    
    "modules-left": [
        "mango/workspaces",
        "mango/layout",
        "mango/window"
    ],
    "modules-center": [],
    "modules-right": [
        "network",
        "battery",
        "custom/controlpanel",
        "clock"
    ],

    // Workspaces - Fixed to hide empty tags
    "mango/workspaces": {
        "format": "{name}",
        "disable-scroll": true,
        "all-outputs": false,
        "hide-empty": true,
        "on-click": "activate"
    },

    "mango/layout": {
        "format": "{symbol}",
    },

    // Active Window
    "mango/window": {
        "format": "{title}",
        "max-length": 50
    },

    // Wi-Fi
    "network": {
        "interface": "wlan0",
        "interval": 60,
        "format-wifi": "",
        "format-disconnected": "󰤭",
        "tooltip-format": "{essid}",
        "on-click": "notify-send -i ~/pix/assets/icons/wifi-solid.svg -a scripts -r 12 'Network' '{essid}'"
    },

    // Battery
    "battery": {
        "states": {
            "full": 85,
            "critical": 14
        },
        // Wrap {capacity}% in a span tag with your preferred dimmer color
        "format": "{icon}   <span color='#928374'>{capacity}%</span>",
        "format-charging": "   <span color='#928374'>{capacity}%</span>",
        "format-plugged": "   <span color='#928374'>{capacity}%</span>",
        "format-icons": ["", "", "", "", ""],
        "on-click": "~/.local/scripts/sb_battery notify"
    },

    // Control Panel
    "custom/controlpanel": {
        "format": "",
        "on-click": "~/.config/eww/scripts/control_center",
        "tooltip": false
    },

    // Date & Time Combined
    "clock": {
        "interval": 60,
        // Notice the "0:" added before the % in both blocks
        "format": "<span color='#928374' size='medium' rise='0000'>{0:%a %d %b}</span>   <span weight='400'>{0:%H:%M }</span>",
        "on-click": "~/.local/scripts/datenotif"
    }
}
